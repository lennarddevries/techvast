---
import { getCollection } from "astro:content"
import Layout from "@/layouts/main.astro"
import ServiceCard from "@/components/ServiceCard.astro"
import { useTranslations, type Locale } from "@/i18n/utils"

const locale = (Astro.currentLocale ?? "nl") as Locale
const t = useTranslations(locale)

const allServices = await getCollection("services", ({ id }) =>
  id.startsWith(`${locale}/`)
)
const services = allServices.sort((a, b) => a.data.order - b.data.order)
---

<Layout seoKey="services">
  <!-- Header -->
  <section class="px-6 pt-20 pb-16">
    <div class="mx-auto max-w-6xl">
      <p
        class="mb-3 text-xs font-medium tracking-widest text-muted-foreground uppercase"
      >
        {t.services.heading}
      </p>
      <h1
        class="font-heading text-5xl leading-tight font-semibold text-foreground md:text-6xl"
      >
        {t.services.subheading}
      </h1>
      <hr class="mt-10 border-border" />
    </div>
  </section>

  <!-- Services grid -->
  <section class="px-6 pb-24" aria-labelledby="services-list">
    <div class="mx-auto max-w-6xl">
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          services.map((service) => (
            <ServiceCard
              title={service.data.title}
              tagline={service.data.tagline}
              description={service.data.description}
              icon={service.data.icon}
              price={service.data.price}
              serviceId={service.data.serviceId}
              locale={locale}
            />
          ))
        }
      </div>
    </div>
  </section>
</Layout>
