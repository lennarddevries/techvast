---
import { getCollection } from "astro:content"
import Layout from "@/layouts/main.astro"
import ServiceCard from "@/components/ServiceCard.astro"
import { useTranslations, type Locale } from "@/i18n/utils"

const locale = (Astro.currentLocale ?? "nl") as Locale
const t = useTranslations(locale)

const allServices = await getCollection("services", ({ id }) =>
  id.startsWith(`${locale}/`)
)
const services = allServices.sort((a, b) => a.data.order - b.data.order)

const servicesJsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  itemListElement: services.map((service, index) => ({
    "@type": "ListItem",
    position: index + 1,
    item: {
      "@type": "Service",
      name: service.data.title,
      description: service.data.description,
      provider: {
        "@type": "Organization",
        name: "Techvast",
      },
      url: `https://techvast.nl${locale === "nl" ? "" : `/${locale}`}/services/${service.data.serviceId}`,
    },
  })),
}
---

<Layout seoKey="services" jsonLd={servicesJsonLd}>
  <!-- Header -->
  <section class="relative overflow-hidden px-6 pt-24 pb-16">
    <!-- Left accent stripe -->
    <div
      class="pointer-events-none absolute top-0 bottom-0 left-0 w-1 bg-accent"
      aria-hidden="true"
    >
    </div>

    <div class="mx-auto max-w-6xl">
      <span
        class="mb-5 inline-flex items-center gap-2 text-xs font-bold tracking-[0.18em] text-muted-foreground uppercase"
        data-reveal
      >
        <span class="inline-block h-px w-5 bg-accent"></span>
        {t.services.heading}
      </span>
      <h1
        class="font-heading text-5xl leading-[0.92] font-bold tracking-tight text-foreground md:text-7xl"
        data-reveal
        data-reveal-delay="80"
      >
        {t.services.subheading}
      </h1>
      <!-- Structural divider -->
      <div
        class="mt-10 flex items-center gap-0"
        data-reveal
        data-reveal-delay="140"
      >
        <span class="h-0.5 w-14 shrink-0 bg-accent"></span>
        <span class="h-px flex-1 bg-foreground/12"></span>
      </div>
    </div>
  </section>

  <!-- Services grid -->
  <section class="px-6 pb-28" aria-labelledby="services-list">
    <div class="mx-auto max-w-6xl">
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          services.map((service, i) => (
            <ServiceCard
              title={service.data.title}
              tagline={service.data.tagline}
              description={service.data.description}
              icon={service.data.icon}
              price={service.data.price}
              serviceId={service.data.serviceId}
              locale={locale}
              revealDelay={i * 60}
            />
          ))
        }
      </div>
    </div>
  </section>
</Layout>
