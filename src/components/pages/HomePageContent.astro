---
import { getCollection } from "astro:content"
import Layout from "@/layouts/main.astro"
import ServiceCard from "@/components/ServiceCard.astro"
import AvailabilityBadge from "@/components/AvailabilityBadge.astro"
import { useTranslations, type Locale } from "@/i18n/utils"

const locale = (Astro.currentLocale ?? "nl") as Locale
const t = useTranslations(locale)

// Availability
const [availData] = await getCollection("availability")
const isAvailable = availData?.data?.available ?? true

// Featured services for this locale
const allServices = await getCollection("services", ({ id }) =>
  id.startsWith(`${locale}/`)
)
const featuredServices = allServices
  .filter((s) => s.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
---

<Layout seoKey="home">
  <!-- ─── Hero ──────────────────────────────────────────────────────────── -->
  <section class="relative overflow-hidden px-6 pt-20 pb-24 md:pt-28 md:pb-32">
    <!-- Background accent blob -->
    <div
      class="pointer-events-none absolute -top-40 -right-40 h-[600px] w-[600px] rounded-full bg-accent/5 blur-3xl"
      aria-hidden="true"
    >
    </div>
    <div
      class="pointer-events-none absolute -bottom-20 -left-20 h-[400px] w-[400px] rounded-full bg-accent/5 blur-3xl"
      aria-hidden="true"
    >
    </div>

    <div class="relative mx-auto max-w-6xl">
      <div class="max-w-3xl">
        <!-- Eyebrow + badge -->
        <div class="mb-6 flex flex-wrap items-center gap-3">
          <span
            class="inline-flex items-center rounded-full border border-border bg-secondary px-3 py-1 text-xs font-medium tracking-widest text-muted-foreground uppercase"
          >
            {t.hero.eyebrow}
          </span>
          <AvailabilityBadge {isAvailable} locale={locale} />
        </div>

        <!-- Headline -->
        <h1
          class="font-heading text-5xl leading-[1.08] font-semibold tracking-tight text-foreground sm:text-6xl md:text-7xl"
        >
          {
            t.hero.headline.split("\n").map((line, i) => (
              <>
                {i > 0 && <br />}
                {i === 1 ? (
                  <em class="text-accent not-italic">{line}</em>
                ) : (
                  line
                )}
              </>
            ))
          }
        </h1>

        <!-- Subheadline -->
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-muted-foreground">
          {t.hero.subheadline}
        </p>

        <!-- CTAs -->
        <div class="mt-10 flex flex-wrap items-center gap-3">
          <a
            href={locale === "nl" ? "/services" : `/${locale}/services`}
            class="inline-flex h-11 items-center rounded-lg bg-primary px-6 text-sm font-medium text-primary-foreground transition-all hover:bg-primary/85 active:scale-[0.98]"
          >
            {t.hero.ctaPrimary}
          </a>
          {
            isAvailable && (
              <a
                href={locale === "nl" ? "/contact" : `/${locale}/contact`}
                class="inline-flex h-11 items-center rounded-lg border border-border bg-transparent px-6 text-sm font-medium text-foreground transition-all hover:bg-secondary active:scale-[0.98]"
              >
                {t.hero.ctaSecondary}
              </a>
            )
          }
        </div>
      </div>
    </div>
  </section>

  <!-- ─── Divider line ─────────────────────────────────────────────────── -->
  <div class="mx-auto max-w-6xl px-6">
    <hr class="border-border" />
  </div>

  <!-- ─── Featured services ──────────────────────────────────────────── -->
  <section class="px-6 py-20" aria-labelledby="featured-heading">
    <div class="mx-auto max-w-6xl">
      <div
        class="mb-12 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between"
      >
        <div>
          <p
            class="mb-2 text-xs font-medium tracking-widest text-muted-foreground uppercase"
          >
            {t.services.featuredHeading}
          </p>
          <h2
            id="featured-heading"
            class="font-heading text-4xl font-semibold text-foreground md:text-5xl"
          >
            {t.services.featuredSubheading}
          </h2>
        </div>
        <a
          href={locale === "nl" ? "/services" : `/${locale}/services`}
          class="inline-flex shrink-0 items-center gap-1.5 text-sm font-medium text-muted-foreground transition-colors hover:text-foreground"
        >
          {t.services.viewAll}
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M5 12h14M12 5l7 7-7 7"></path>
          </svg>
        </a>
      </div>

      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-2">
        {
          featuredServices.map((service) => (
            <ServiceCard
              title={service.data.title}
              tagline={service.data.tagline}
              description={service.data.description}
              icon={service.data.icon}
              price={service.data.price}
              serviceId={service.data.serviceId}
              locale={locale}
              featured
            />
          ))
        }
      </div>
    </div>
  </section>

  <!-- ─── How it works ─────────────────────────────────────────────────── -->
  <section class="bg-secondary/40 px-6 py-20" aria-labelledby="process-heading">
    <div class="mx-auto max-w-6xl">
      <div class="mb-12 text-center">
        <p
          class="mb-2 text-xs font-medium tracking-widest text-muted-foreground uppercase"
        >
          {t.process.heading}
        </p>
        <h2
          id="process-heading"
          class="font-heading text-4xl font-semibold text-foreground md:text-5xl"
        >
          {t.process.subheading}
        </h2>
      </div>

      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          t.process.steps.map((step, i) => (
            <div class="relative flex flex-col gap-3 rounded-xl border border-border bg-card p-6">
              <span class="font-heading text-4xl leading-none font-semibold text-accent/30">
                {String(i + 1).padStart(2, "0")}
              </span>
              <h3 class="font-heading text-lg font-semibold text-foreground">
                {step.title}
              </h3>
              <p class="text-sm leading-relaxed text-muted-foreground">
                {step.description}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ─── Why me ────────────────────────────────────────────────────────── -->
  <section class="px-6 py-20" aria-labelledby="why-heading">
    <div class="mx-auto max-w-6xl">
      <div class="grid gap-12 lg:grid-cols-2 lg:items-center">
        <div>
          <p
            class="mb-2 text-xs font-medium tracking-widest text-muted-foreground uppercase"
          >
            {t.whyMe.heading}
          </p>
          <h2
            id="why-heading"
            class="font-heading text-4xl leading-tight font-semibold text-foreground md:text-5xl"
          >
            {t.whyMe.subheading}
          </h2>
        </div>
        <div class="grid gap-4 sm:grid-cols-2">
          {
            t.whyMe.points.map((point) => (
              <div class="flex flex-col gap-2 rounded-xl border border-border bg-card p-5">
                <h3 class="font-heading text-lg font-semibold text-foreground">
                  {point.title}
                </h3>
                <p class="text-sm leading-relaxed text-muted-foreground">
                  {point.description}
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- ─── CTA banner ────────────────────────────────────────────────────── -->
  {
    isAvailable && (
      <section class="px-6 pb-20">
        <div class="mx-auto max-w-6xl">
          <div class="grain relative overflow-hidden rounded-2xl bg-primary px-8 py-12 text-center md:py-16">
            <h2 class="mb-4 font-heading text-4xl font-semibold text-primary-foreground md:text-5xl">
              {t.cta.heading}
            </h2>
            <p class="mx-auto mb-8 max-w-md text-base text-primary-foreground/70">
              {t.cta.subheading}
            </p>
            <a
              href={locale === "nl" ? "/contact" : `/${locale}/contact`}
              class="inline-flex h-11 items-center rounded-lg bg-accent px-8 text-sm font-medium text-accent-foreground transition-all hover:bg-accent/85 active:scale-[0.98]"
            >
              {t.cta.button}
            </a>
          </div>
        </div>
      </section>
    )
  }
</Layout>
