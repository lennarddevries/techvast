---
import Layout from "@/layouts/main.astro"
import { useTranslations, type Locale } from "@/i18n/utils"

const locale = (Astro.currentLocale ?? "nl") as Locale
const t = useTranslations(locale)
const a = t.about
---

<Layout seoKey="about">
  <!-- Header -->
  <section class="px-6 pt-20 pb-12">
    <div class="mx-auto max-w-6xl">
      <p
        class="mb-3 text-xs font-medium tracking-widest text-muted-foreground uppercase"
      >
        {a.eyebrow}
      </p>
      <h1
        class="font-heading text-5xl font-semibold text-foreground md:text-6xl"
      >
        {a.heading}
      </h1>
      <p class="mt-2 text-lg font-medium text-accent">{a.intro}</p>
    </div>
  </section>

  <!-- Bio + stats -->
  <section class="px-6 pb-20">
    <div class="mx-auto grid max-w-6xl gap-12 lg:grid-cols-3">
      <!-- Bio -->
      <div class="space-y-5 lg:col-span-2">
        {
          a.bio
            .split("\n\n")
            .map((para) => (
              <p class="text-base leading-relaxed text-muted-foreground">
                {para}
              </p>
            ))
        }
      </div>

      <!-- Stats -->
      <div class="flex flex-col gap-4">
        <div class="grid grid-cols-2 gap-4">
          {
            a.stats.map((stat) => (
              <div class="rounded-xl border border-border bg-card p-5 text-center">
                <p class="font-heading text-3xl font-semibold text-accent">
                  {stat.value}
                </p>
                <p class="mt-1 text-xs text-muted-foreground">{stat.label}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- Skills -->
  <section class="bg-secondary/40 px-6 py-16">
    <div class="mx-auto max-w-6xl">
      <h2 class="mb-8 font-heading text-2xl font-semibold text-foreground">
        {a.skills.heading}
      </h2>
      <div class="flex flex-wrap gap-2">
        {
          a.skills.list.map((skill) => (
            <span class="inline-flex items-center rounded-full border border-border bg-card px-3 py-1.5 text-sm text-foreground">
              {skill}
            </span>
          ))
        }
      </div>
    </div>
  </section>
</Layout>
