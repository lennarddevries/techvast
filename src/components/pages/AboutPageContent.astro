---
import Layout from "@/layouts/main.astro"
import { useTranslations, type Locale } from "@/i18n/utils"

const locale = (Astro.currentLocale ?? "nl") as Locale
const t = useTranslations(locale)
const a = t.about
---

<Layout seoKey="about">
  <!-- Header: text left, photo right -->
  <section class="relative overflow-hidden px-6 pt-24 pb-16">
    <!-- Left accent stripe -->
    <div
      class="pointer-events-none absolute top-0 bottom-0 left-0 w-1 bg-accent"
      aria-hidden="true"
    >
    </div>

    <div class="mx-auto max-w-6xl">
      <div class="flex flex-col gap-12 lg:flex-row lg:items-end lg:gap-16">
        <!-- Text content -->
        <div class="flex-1">
          <span
            class="mb-5 inline-flex items-center gap-2 text-xs font-bold tracking-[0.18em] text-muted-foreground uppercase"
            data-reveal
          >
            <span class="inline-block h-px w-5 bg-accent"></span>
            {a.eyebrow}
          </span>
          <h1
            class="font-heading text-5xl leading-[0.92] font-bold tracking-tight text-foreground md:text-7xl"
            data-reveal
            data-reveal-delay="80"
          >
            {a.heading}
          </h1>
          <!-- Structural divider -->
          <div
            class="mt-8 flex items-center gap-0"
            data-reveal
            data-reveal-delay="140"
          >
            <span class="h-px w-14 shrink-0 bg-accent"></span>
            <span class="h-px flex-1 bg-foreground/12"></span>
          </div>
          <p
            class="mt-6 text-lg font-medium text-accent"
            data-reveal
            data-reveal-delay="180"
          >
            {a.intro}
          </p>
        </div>

        <!-- Photo -->
        <div
          class="relative w-full shrink-0 lg:w-64 xl:w-72"
          data-reveal
          data-reveal-delay="200"
        >
          <!-- Geometric offset accent frame -->
          <div
            class="pointer-events-none absolute -right-3 -bottom-3 h-full w-full border border-accent/50"
            aria-hidden="true"
          >
          </div>

          <!-- Photo container with placeholder -->
          <div
            class="relative aspect-[4/5] overflow-hidden border border-border bg-secondary"
          >
            <!-- Placeholder silhouette -->
            <div
              class="absolute inset-0 flex items-end justify-center"
              aria-hidden="true"
            >
              <svg
                viewBox="0 0 100 120"
                xmlns="http://www.w3.org/2000/svg"
                class="h-4/5 w-auto"
                fill="currentColor"
                style="color: oklch(0.10 0.028 258 / 0.07)"
              >
                <ellipse cx="50" cy="38" rx="22" ry="24"></ellipse>
                <path d="M5 120 C5 80 95 80 95 120Z"></path>
              </svg>
            </div>

            <!-- Actual photo — place profile.jpg in /public/ -->
            <img
              src="/profile.jpg"
              alt={a.heading}
              class="absolute inset-0 h-full w-full object-cover object-top"
              loading="eager"
              onerror="this.style.visibility='hidden'"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Bio + stats -->
  <section class="px-6 pb-24">
    <div class="mx-auto grid max-w-6xl gap-16 lg:grid-cols-3">
      <!-- Bio -->
      <div class="space-y-5 lg:col-span-2">
        {
          a.bio.split("\n\n").map((para, i) => (
            <p
              class="text-base leading-relaxed text-muted-foreground"
              data-reveal
              data-reveal-delay={i * 80}
            >
              {para}
            </p>
          ))
        }
      </div>

      <!-- Stats: large numbers, structural treatment -->
      <div class="flex flex-col gap-0 border border-border">
        {
          a.stats.map((stat, i) => (
            <div
              class:list={[
                "flex flex-col gap-1 p-6",
                i < a.stats.length - 1 ? "border-b border-border" : "",
              ]}
              data-reveal
              data-reveal-delay={i * 80}
            >
              <p
                class="font-heading text-5xl font-bold text-accent"
                data-counter={stat.value}
              >
                {stat.value}
              </p>
              <p class="text-xs font-semibold tracking-wider text-muted-foreground uppercase">
                {stat.label}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Skills -->
  <section class="border-y border-border bg-secondary/60 px-6 py-20">
    <div class="mx-auto max-w-6xl">
      <div class="mb-4 flex items-center gap-5" data-reveal>
        <span class="h-px w-8 bg-accent"></span>
        <h2
          class="font-heading text-2xl font-bold tracking-tight text-foreground uppercase"
        >
          {a.skills.heading}
        </h2>
      </div>
      <div class="mt-8 flex flex-wrap gap-2">
        {
          a.skills.list.map((skill, i) => (
            <span
              class="inline-flex items-center border border-foreground/15 bg-card px-3 py-1.5 text-sm font-medium text-foreground transition-colors hover:border-accent/50 hover:bg-accent/5"
              data-reveal
              data-reveal-delay={i * 40}
            >
              {skill}
            </span>
          ))
        }
      </div>
    </div>
  </section>
</Layout>

<script>
  // ─── Animated stat counters ───────────────────────────────────────────────
  ;(function () {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return
          const el = entry.target as HTMLElement
          const raw = el.dataset.counter ?? ""
          const match = raw.match(/^(\d+)(.*)$/)
          if (!match) return

          const target = parseInt(match[1])
          const suffix = match[2]
          const duration = 1400

          let startTime: number | null = null
          const tick = (timestamp: number) => {
            if (!startTime) startTime = timestamp
            const progress = Math.min((timestamp - startTime) / duration, 1)
            // ease-out-quart
            const eased = 1 - Math.pow(1 - progress, 4)
            el.textContent = Math.round(eased * target) + suffix
            if (progress < 1) requestAnimationFrame(tick)
          }
          requestAnimationFrame(tick)
          observer.unobserve(el)
        })
      },
      { threshold: 0.6 }
    )

    document
      .querySelectorAll<HTMLElement>("[data-counter]")
      .forEach((el) => observer.observe(el))
  })()
</script>
