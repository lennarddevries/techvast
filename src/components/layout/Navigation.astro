---
import { useTranslations, localePath, type Locale } from "@/i18n/utils"
import AvailabilityBadge from "@/components/AvailabilityBadge.astro"

interface Props {
  locale: Locale
  isAvailable: boolean
}

const { locale, isAvailable } = Astro.props
const t = useTranslations(locale)

const currentPath = Astro.url.pathname

// Build locale switcher URLs
const locales: Locale[] = ["nl", "en", "de"]
const localeSwitcher = locales.map((l) => ({
  locale: l,
  label: l.toUpperCase(),
  href: localePath(currentPath, l, locale),
  current: l === locale,
}))

// Nav links
const navLinks = [
  {
    label: t.nav.home,
    href: locale === "nl" ? "/" : `/${locale}/`,
    current:
      currentPath === "/" ||
      currentPath === `/${locale}/` ||
      currentPath === `/${locale}`,
  },
  {
    label: t.nav.services,
    href: locale === "nl" ? "/services" : `/${locale}/services`,
    current: currentPath.includes("/services"),
  },
  {
    label: t.nav.about,
    href: locale === "nl" ? "/about" : `/${locale}/about`,
    current: currentPath.includes("/about"),
  },
  {
    label: t.nav.contact,
    href: isAvailable
      ? locale === "nl"
        ? "/contact"
        : `/${locale}/contact`
      : null,
    current: currentPath.includes("/contact"),
    disabled: !isAvailable,
    hint: !isAvailable ? t.nav.unavailableHint : undefined,
  },
]
---

<header
  class="sticky top-0 z-50 border-b border-border/60 bg-background/90 backdrop-blur-md"
>
  <nav
    class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4"
    aria-label="Main navigation"
  >
    <!-- Logo -->
    <a
      href={locale === "nl" ? "/" : `/${locale}/`}
      class="group flex items-center gap-3"
      aria-label="Techvast — home"
    >
      <span
        class="font-heading text-xl font-semibold tracking-tight text-foreground transition-colors group-hover:text-accent"
      >
        Techvast
      </span>
      <AvailabilityBadge {isAvailable} locale={locale} compact />
    </a>

    <!-- Desktop nav links -->
    <ul class="hidden items-center gap-1 md:flex" role="list">
      {
        navLinks.map((link) => (
          <li>
            {link.disabled ? (
              <span
                class="relative cursor-not-allowed px-3 py-2 text-sm text-muted-foreground/50 select-none"
                title={link.hint}
                aria-disabled="true"
              >
                {link.label}
              </span>
            ) : (
              <a
                href={link.href!}
                class:list={[
                  "relative rounded-md px-3 py-2 text-sm transition-colors",
                  link.current
                    ? "font-medium text-foreground"
                    : "text-muted-foreground hover:bg-secondary hover:text-foreground",
                ]}
                aria-current={link.current ? "page" : undefined}
              >
                {link.label}
                {link.current && (
                  <span class="absolute right-3 bottom-0 left-3 h-px rounded-full bg-accent" />
                )}
              </a>
            )}
          </li>
        ))
      }
    </ul>

    <!-- Desktop right: locale switcher + CTA -->
    <div class="hidden items-center gap-4 md:flex">
      <!-- Locale switcher -->
      <div
        class="flex items-center gap-0.5 text-xs"
        role="navigation"
        aria-label="Language selection"
      >
        {
          localeSwitcher.map((item, i) => (
            <>
              {i > 0 && <span class="text-border">·</span>}
              {item.current ? (
                <span class="px-1.5 py-0.5 font-semibold text-foreground">
                  {item.label}
                </span>
              ) : (
                <a
                  href={item.href}
                  class="px-1.5 py-0.5 text-muted-foreground transition-colors hover:text-foreground"
                  hreflang={item.locale}
                  lang={item.locale}
                >
                  {item.label}
                </a>
              )}
            </>
          ))
        }
      </div>

      <!-- CTA button (only shown when available) -->
      {
        isAvailable && (
          <a
            href={locale === "nl" ? "/contact" : `/${locale}/contact`}
            class="inline-flex h-8 items-center rounded-lg bg-accent px-3 text-sm font-medium text-accent-foreground transition-all hover:bg-accent/85 active:scale-[0.98]"
          >
            {t.nav.contact}
          </a>
        )
      }
    </div>

    <!-- Mobile menu button -->
    <button
      id="mobile-menu-btn"
      type="button"
      class="flex h-9 w-9 items-center justify-center rounded-lg text-muted-foreground transition-colors hover:bg-secondary hover:text-foreground md:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Open menu"
    >
      <svg
        id="icon-open"
        xmlns="http://www.w3.org/2000/svg"
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <line x1="4" x2="20" y1="6" y2="6"></line>
        <line x1="4" x2="20" y1="12" y2="12"></line>
        <line x1="4" x2="20" y1="18" y2="18"></line>
      </svg>
      <svg
        id="icon-close"
        xmlns="http://www.w3.org/2000/svg"
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        class="hidden"
      >
        <path d="M18 6 6 18"></path><path d="m6 6 12 12"></path>
      </svg>
    </button>
  </nav>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="hidden border-t border-border/60 bg-background md:hidden"
    role="dialog"
    aria-label="Mobile navigation"
  >
    <ul class="flex flex-col gap-1 px-6 py-4" role="list">
      {
        navLinks.map((link) => (
          <li>
            {link.disabled ? (
              <span class="block cursor-not-allowed px-3 py-2.5 text-sm text-muted-foreground/50">
                {link.label}
                <span class="mt-0.5 block text-xs text-muted-foreground/40">
                  {link.hint}
                </span>
              </span>
            ) : (
              <a
                href={link.href!}
                class:list={[
                  "block rounded-lg px-3 py-2.5 text-sm transition-colors",
                  link.current
                    ? "bg-secondary font-medium text-foreground"
                    : "text-muted-foreground hover:bg-secondary hover:text-foreground",
                ]}
                aria-current={link.current ? "page" : undefined}
              >
                {link.label}
              </a>
            )}
          </li>
        ))
      }
    </ul>

    <!-- Mobile locale switcher -->
    <div
      class="flex items-center gap-3 px-9 pb-4 text-sm text-muted-foreground"
    >
      {
        localeSwitcher.map((item) =>
          item.current ? (
            <span class="font-semibold text-foreground">{item.label}</span>
          ) : (
            <a
              href={item.href}
              class="transition-colors hover:text-foreground"
              hreflang={item.locale}
            >
              {item.label}
            </a>
          )
        )
      }
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById("mobile-menu-btn")
  const menu = document.getElementById("mobile-menu")
  const iconOpen = document.getElementById("icon-open")
  const iconClose = document.getElementById("icon-close")

  btn?.addEventListener("click", () => {
    const isOpen = !menu?.classList.contains("hidden")
    menu?.classList.toggle("hidden", isOpen)
    iconOpen?.classList.toggle("hidden", !isOpen)
    iconClose?.classList.toggle("hidden", isOpen)
    btn.setAttribute("aria-expanded", String(!isOpen))
  })
</script>
