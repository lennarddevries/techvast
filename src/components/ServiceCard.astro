---
import { useTranslations, type Locale } from "@/i18n/utils"

interface Props {
  title: string
  tagline: string
  description: string
  icon: string
  price?: string
  serviceId: string
  locale: Locale
  /** Render as a featured/larger card */
  featured?: boolean
}

const {
  title,
  tagline,
  description,
  icon,
  price,
  serviceId,
  locale,
  featured = false,
} = Astro.props
const t = useTranslations(locale)

const href =
  locale === "nl"
    ? `/services/${serviceId}`
    : `/${locale}/services/${serviceId}`

// Map icon name to SVG path (Lucide-style)
const iconPaths: Record<string, string> = {
  inbox:
    "M22 12h-6l-2 3H10l-2-3H2M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z",
  kanban:
    "M6 3H3a1 1 0 0 0-1 1v16a1 1 0 0 0 1 1h3a1 1 0 0 0 1-1V4a1 1 0 0 0-1-1zM13.5 3h-3a1 1 0 0 0-1 1v10a1 1 0 0 0 1 1h3a1 1 0 0 0 1-1V4a1 1 0 0 0-1-1zM21 3h-3a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1h3a1 1 0 0 0 1-1V4a1 1 0 0 0-1-1z",
  "message-circle": "M7.9 20A9 9 0 1 0 4 16.1L2 22z",
  search: "m21 21-4.35-4.35M17 11A6 6 0 1 1 5 11a6 6 0 0 1 12 0z",
  "share-2": "M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8M16 6l-4-4-4 4M12 2v13",
}

const path = iconPaths[icon] ?? iconPaths.inbox
---

<a
  href={href}
  class:list={[
    "group flex flex-col rounded-xl border border-border bg-card p-6 transition-all duration-200",
    "hover:-translate-y-0.5 hover:border-accent/50 hover:shadow-md",
    featured ? "lg:p-8" : "",
  ]}
  aria-label={`${title} — ${t.services.learnMore}`}
>
  <!-- Icon -->
  <div
    class="mb-4 flex h-10 w-10 items-center justify-center rounded-lg bg-accent/10 text-accent transition-colors group-hover:bg-accent/20"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="20"
      height="20"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.75"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d={path}></path>
    </svg>
  </div>

  <!-- Content -->
  <h3
    class:list={[
      "mb-1 font-heading leading-tight font-semibold text-foreground",
      featured ? "text-2xl" : "text-xl",
    ]}
  >
    {title}
  </h3>
  <p class="mb-2 text-sm font-medium text-accent">{tagline}</p>
  <p class="mb-4 flex-1 text-sm leading-relaxed text-muted-foreground">
    {description}
  </p>

  <!-- Footer -->
  <div
    class="mt-auto flex items-center justify-between border-t border-border/60 pt-4"
  >
    {
      price && (
        <span class="text-xs font-medium text-muted-foreground">{price}</span>
      )
    }
    <span
      class="ml-auto inline-flex items-center gap-1 text-sm font-medium text-foreground transition-colors group-hover:text-accent"
    >
      {t.services.learnMore}
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        class="transition-transform group-hover:translate-x-0.5"
      >
        <path d="M5 12h14M12 5l7 7-7 7"></path>
      </svg>
    </span>
  </div>
</a>
