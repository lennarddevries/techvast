---
import { useTranslations, type Locale } from "@/i18n/utils"

interface Props {
  title: string
  tagline: string
  description: string
  icon: string
  price?: string
  serviceId: string
  locale: Locale
  /** Render as a featured/larger card */
  featured?: boolean
  /** Stagger delay in ms for scroll-reveal animation */
  revealDelay?: number
}

const {
  title,
  tagline,
  description,
  icon,
  price,
  serviceId,
  locale,
  featured = false,
  revealDelay,
} = Astro.props
const t = useTranslations(locale)

const href =
  locale === "nl"
    ? `/services/${serviceId}`
    : `/${locale}/services/${serviceId}`

// Map icon name to SVG path data (Lucide-style, multiple subpaths combined)
