---
import { useTranslations, type Locale } from "@/i18n/utils"

interface Props {
  isAvailable: boolean
  locale: Locale
  /** Compact mode: just the dot + label, no message */
  compact?: boolean
}

const { isAvailable, locale, compact = false } = Astro.props
const t = useTranslations(locale)

const label = isAvailable
  ? t.availability.available
  : t.availability.unavailable
---

{
  compact ? (
    <span
      class:list={[
        "inline-flex items-center gap-1.5 border px-2 py-0.5 text-[10px] font-bold tracking-wider uppercase",
        isAvailable
          ? "border-[oklch(0.62_0.17_155/0.35)] bg-[oklch(0.62_0.17_155/0.08)] text-[oklch(0.35_0.14_155)]"
          : "border-border bg-muted text-muted-foreground",
      ]}
      aria-label={label}
    >
      <span
        class:list={[
          "size-1.5",
          isAvailable
            ? "availability-dot bg-[oklch(0.52_0.17_155)]"
            : "bg-muted-foreground/50",
        ]}
        aria-hidden="true"
      />
      {label}
    </span>
  ) : (
    <div
      class:list={[
        "inline-flex items-center gap-2 border px-3 py-1 text-xs font-bold tracking-wider uppercase",
        isAvailable
          ? "border-[oklch(0.62_0.17_155/0.35)] bg-[oklch(0.62_0.17_155/0.08)] text-[oklch(0.32_0.14_155)]"
          : "border-border bg-muted text-muted-foreground",
      ]}
    >
      <span
        class:list={[
          "size-1.5",
          isAvailable
            ? "availability-dot bg-[oklch(0.52_0.17_155)]"
            : "bg-muted-foreground/50",
        ]}
        aria-hidden="true"
      />
      <span>{label}</span>
    </div>
  )
}
